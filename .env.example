# Database
DATABASE_PATH=database/expenses.db

# Gmail API
GMAIL_CREDENTIALS_PATH=config/gmail_credentials.json
GMAIL_TOKEN_KEYCHAIN_SERVICE=expense-intelligence
GMAIL_TOKEN_KEYCHAIN_USERNAME=gmail_oauth
GMAIL_QUERY_LABEL=INBOX
GMAIL_SYNC_INTERVAL_MINUTES=30

# FastAPI
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
FASTAPI_RELOAD=true

# Streamlit
STREAMLIT_HOST=127.0.0.1
STREAMLIT_PORT=8501

# AI Configuration (Optional - set to disable AI features)
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_RETRIES=3

# Logging
LOG_LEVEL=INFO
LOG_PATH=logs

# Settings
LOCAL_ONLY=false
